{
  "expo": {
    "name": "Frikidex",
    "slug": "frikidex",
    "scheme": "frikidex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.frikidex.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.frikidex.app",
      "adaptiveIcon": {
        "backgroundColor": "#6D4AFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-secure-store",
      "expo-splash-screen",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Frikidex usa la cámara para fotografiar tus objetos y leer códigos de barras."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Frikidex necesita acceder a tus fotos para agregarlas a tus objetos."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "55431829-1a16-4348-801c-5cfb60dde329"
      }
    },
    "owner": "erigobre"
  }
}
