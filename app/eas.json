{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_USE_RN_FETCH": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_USE_RN_FETCH": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "iamkikelo@gmail.com",
        "ascAppId": "6814719255",
        "appleTeamId": "3486775WTQ"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
