// Modelo de datos — Inventario de Coleccionables
// Ver docs/00-PLAN-MAESTRO.md para el contexto/decisiones detrás de cada entidad.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Cuentas / usuarios / SaaS
// ---------------------------------------------------------------------------

enum UserRole {
  SUPERADMIN
  OWNER // dueño de la Organization (cuenta familia/negocio)
  MEMBER // miembro invitado dentro de la Organization
}

enum UserStatus {
  ACTIVE
  SUSPENDED // bloqueada por moderación (ver ModerationFlag) o manualmente por un superadmin
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  SPONSORED // cuenta patrocinada por el superadmin, nunca paga
}

// Unidad de facturación SaaS. Una Organization agrupa 1+ Users bajo un mismo
// paquete/plan. En v1 los miembros de una misma Organization NO comparten
// colecciones/ubicaciones entre sí (eso es v1.1) — solo comparten el plan/pago.
model Organization {
  id                 String             @id @default(cuid())
  name               String
  plan               String? // paquete contratado (se define en Fase 2 de negocio)
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  sponsored          Boolean            @default(false) // activado desde Superadmin, exime de pago
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users    User[]
  payments Payment[]

  // FrikiTokens: el saldo cuelga de la Organization (igual que plan/payments),
  // no del User, porque así ya se factura todo lo demás (plan §7.1: los
  // miembros de una misma Organization comparten plan/pago).
  ftLots         FtLot[]
  ftTransactions FtTransaction[]
  ftFreeGrantAt  DateTime? // última vez que se le dio el regalo mensual de FT gratis

  moderationFlags ModerationFlag[]

  @@map("organizations")
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email        String   @unique
  // @usuario único para poder seguir gente y armar el feed de la colección (plan futuro).
  username     String?  @unique
  passwordHash String
  name         String
  role         UserRole   @default(OWNER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  locations             Location[]
  seasons               Season[]
  collections           Collection[]
  tags                  Tag[]
  items                 Item[]
  wishlistItems         WishlistItem[]
  sentTransfers         Transfer[]         @relation("TransferSender")
  receivedTransfers     Transfer[]         @relation("TransferReceiver")
  usageEvents           UsageEvent[]
  locationMemberships   LocationMember[]
  collectionMemberships CollectionMember[]
  ftTransactions        FtTransaction[] // quién disparó cada cobro, para auditoría
  moderationFlags       ModerationFlag[] // incidentes de moderación de IA disparados por este usuario
  pushTokens            PushToken[]

  // Qué versión de cada documento legal aceptó al registrarse y cuándo (plan
  // §5: hay que poder probar qué texto exacto aceptó cada usuario, no solo
  // que "aceptó algo"). Ver api/src/legal/*.page.ts para las constantes de versión.
  privacyVersionAccepted String?
  termsVersionAccepted   String?
  legalAcceptedAt        DateTime?

  @@map("users")
}

// Preparado desde v1 para no migrar esquema en v1.1, pero sin UI/lógica de
// invitación todavía (ver docs/00-PLAN-MAESTRO.md §7.1).
enum SharedRole {
  OWNER
  EDITOR
  VIEWER
}

model CollectionMember {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         SharedRole @default(EDITOR)
  createdAt    DateTime   @default(now())

  @@unique([collectionId, userId])
  @@map("collection_members")
}

enum LocationMemberSource {
  MANUAL
  INHERITED_FROM_COLLECTION
}

model LocationMember {
  id         String               @id @default(cuid())
  locationId String
  location   Location             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       SharedRole           @default(VIEWER)
  source     LocationMemberSource @default(MANUAL)
  createdAt  DateTime             @default(now())

  @@unique([locationId, userId])
  @@map("location_members")
}

// Fase 2 de negocio (pagos SaaS reales) — modelo listo desde ahora.
enum PaymentStatus {
  PAID
  PENDING
  FAILED
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("MXN")
  status         PaymentStatus @default(PENDING)
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime      @default(now())

  @@map("payments")
}

// Log ligero de uso para las estadísticas del backend Superadmin.
enum UsageEventType {
  ITEM_CREATED
  AI_SCAN
  MARKET_PRICE_LOOKUP
  TRANSFER_COMPLETED
  LOGIN
}

model UsageEvent {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      UsageEventType
  metadata  Json?
  createdAt DateTime       @default(now())

  @@index([userId, type])
  @@map("usage_events")
}

// ---------------------------------------------------------------------------
// FrikiTokens (FT): moneda virtual interna para medir/cobrar el uso de IA
// (Gemini). El saldo vive en la Organization (ver comentario en Organization).
// ---------------------------------------------------------------------------

// Acciones de IA que cuestan FT. Catálogo editable desde el panel Superadmin
// (Fase 9); esta tabla guarda el costo vigente, sembrado con valores iniciales
// en la migración.
enum FtServiceKey {
  CREATE_WITH_AI      // Analizar fotos al dar de alta (sin búsqueda web)
  SCAN_HAVE_IT        // "¿Ya lo tengo?" con foto (sin búsqueda web)
  BARCODE_LOOKUP      // Lectura de código de barras (con búsqueda web)
  MARKET_PRICE_FRESH  // Precio de mercado, consulta nueva a Gemini (con búsqueda web)
  MARKET_PRICE_CACHED // Precio de mercado, reutilizando el último resultado guardado
}

model FtServiceConfig {
  key       FtServiceKey @id
  label     String
  ftCost    Int
  active    Boolean      @default(true)
  updatedAt DateTime     @updatedAt

  @@map("ft_service_configs")
}

// Perillas globales del módulo, editables a futuro desde Superadmin sin
// necesitar un deploy (ej. cuántos FT gratis se regalan al mes).
model FtConfig {
  key   String @id
  value Int

  @@map("ft_configs")
}

enum FtLotSource {
  MONTHLY_FREE // Regalo mensual del plan gratuito
  PURCHASE     // Compra real (IAP / Stripe) — fase futura
  PROMO        // Regalo manual del superadmin
  REFUND       // Devolución de un cobro que se retuvo (HELD) pero falló
}

// El saldo se guarda por "lotes", no como un solo número: así cada lote puede
// expirar por su cuenta (ej. el regalo mensual) y se gasta primero el que
// vence antes (o el que ya expiró se ignora), sin afectar lotes comprados que
// no expiran.
model FtLot {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source         FtLotSource
  amount         Int // saldo restante de este lote
  originalAmount Int // monto original, para historial/reportes
  expiresAt      DateTime? // null = no expira (ej. FT comprados)
  createdAt      DateTime     @default(now())

  @@index([organizationId, expiresAt])
  @@map("ft_lots")
}

enum FtTransactionType {
  CHARGE // Consumo por una acción de IA
  GRANT  // Alta de FT: regalo mensual, promo o compra
}

enum FtTransactionStatus {
  HELD      // Descontado del saldo, esperando que la acción de IA termine (patrón hold/confirm/release)
  CONFIRMED // La acción de IA terminó bien; el cobro queda en firme
  RELEASED  // La acción de IA falló; el saldo se devolvió (lote FtLotSource.REFUND)
}

// Bitácora de cada movimiento de FT. `idempotencyKey` evita cobrar 2 veces si
// el cliente reintenta la misma acción (ej. por un timeout de red), y
// `realCostUsd` (calculado del usageMetadata real de Gemini) sirve para medir
// el margen real entre lo cobrado en FT y lo que cuesta la IA de verdad.
model FtTransaction {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String? // null en regalos automáticos (regalo mensual, sin usuario que lo dispare)
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  type           FtTransactionType
  service        FtServiceKey?
  status         FtTransactionStatus @default(HELD)
  ftAmount       Int // siempre positivo; el signo lo da `type`
  idempotencyKey String              @unique
  realCostUsd    Decimal?            @db.Decimal(10, 6)
  metadata       Json?
  createdAt      DateTime            @default(now())
  confirmedAt    DateTime?

  @@index([organizationId, createdAt])
  @@map("ft_transactions")
}

// Paquete de compra única de FT (ej. "300 FT por $179 MXN"), mostrado en la
// landing pública y (a futuro) en la tienda in-app. Editable desde Superadmin
// sin deploy (Fase 9); hoy se siembra por migración con los valores que ya
// estaban hardcodeados en la landing. Los campos `store*`/`stripe*` quedan
// listos para la fase de pagos (aún no construida) para no migrar de nuevo.
model FtPackage {
  id                     String    @id @default(cuid())
  code                   String    @unique
  ftAmount               Int
  priceMxnCents          Int
  badge                  String?
  isActive               Boolean   @default(true)
  sortOrder              Int       @default(0)
  availableFrom          DateTime?
  availableUntil         DateTime?
  stripePriceId          String?
  storeProductIdIos      String?
  storeProductIdAndroid  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@map("ft_packages")
}

// Plan de suscripción (ej. "Coleccionista: 250 FT/mes"). v1 solo vende
// mensual (decisión de negocio 2026-09-23, ver docs/00-PLAN-MAESTRO.md);
// `annualEnabled`/`annualPriceMxnCents` ya existen para activar anual después
// sin volver a migrar.
model FtPlan {
  id                    String    @id @default(cuid())
  code                  String    @unique
  label                 String
  ftAmountMonthly       Int
  monthlyPriceMxnCents  Int
  annualPriceMxnCents   Int?
  annualEnabled         Boolean   @default(false)
  badge                 String?
  isActive              Boolean   @default(true)
  sortOrder             Int       @default(0)
  stripePriceIdMonthly  String?
  stripePriceIdAnnual   String?
  storeProductIdIos     String?
  storeProductIdAndroid String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("ft_plans")
}

// Lista de espera de la landing pública (frikidex.com). Un correo puede
// reescribir su registro (ej. si primero usó el form del hero y luego el del
// modal) — por eso el upsert es por email, no un historial de envíos.
model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  interest  String? // "¿qué coleccionas?", texto libre opcional
  source    String   @default("landing")
  ip        String?
  consent   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("waitlist")
}

// Qué se hizo automáticamente al detectar el incidente. AUTO_SUSPENDED solo se
// usa para la señal de más confianza (el filtro de seguridad propio de Google,
// auditado para esto); todo lo demás (ej. "no parece un objeto coleccionable",
// que puede confundirse con una figura/muñeco con rostro humano) solo se
// marca para revisión humana, nunca suspende sola.
enum ModerationAction {
  AUTO_SUSPENDED
  FLAGGED_FOR_REVIEW
}

// Incidente detectado por la IA al analizar fotos (plan: bloqueo/reporte de
// contenido no apto, confirmado con el owner 2026-09-22). `category` queda
// como texto libre (no enum cerrado) porque viene de las categorías de Google
// (HarmCategory) o de nuestro propio check, y Google puede agregar categorías
// sin que eso requiera una migración. `userId` es nullable con SetNull (igual
// que FtTransaction) para que el historial de moderación sobreviva aunque la
// cuenta se borre después.
model ModerationFlag {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  context        String // endpoint/flujo que lo disparó: "analyzePhotos" | "identify"
  category       String // ej. "sexually_explicit", "not_collectible", "possible_person"
  detail         String?           @db.Text // nota de la IA para que el revisor entienda qué vio
  action         ModerationAction
  reviewedAt     DateTime?
  reviewedById   String? // id del superadmin que revisó (sin relación FK: no debe romperse si ese admin se borra)
  resolution     String?           @db.Text
  createdAt      DateTime          @default(now())

  @@index([organizationId, createdAt])
  @@map("moderation_flags")
}

// ---------------------------------------------------------------------------
// Ubicaciones (con sub-ubicaciones) y Temporadas
// ---------------------------------------------------------------------------

model Location {
  id       String     @id @default(cuid())
  ownerId  String
  owner    User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name     String
  parentId String?
  parent   Location?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Location[] @relation("LocationTree")

  isPermanentDefault Boolean  @default(false) // "Ubicación permanente" default del owner
  qrToken            String   @unique @default(cuid()) // valor codificado en el QR impreso
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  members          LocationMember[]
  itemsAsCurrent   Item[]           @relation("ItemCurrentLocation")
  itemsAsPermanent Item[]           @relation("ItemPermanentLocation")

  @@map("locations")
}

model Season {
  id             String    @id @default(cuid())
  ownerId        String
  owner          User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String // Halloween, Navidad, Pascua, etc.
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime  @default(now())
  // Evita reenviar el push de "temporada por terminar" más de una vez.
  reminderSentAt DateTime?

  items Item[]

  @@map("seasons")
}

// Token de push de Expo por dispositivo. Un mismo dispositivo puede terminar
// asociado a otra cuenta (logout + login de otro usuario) — por eso `token`
// es único y no compuesto con `userId`: al re-registrar se reasigna el dueño.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_tokens")
}

// ---------------------------------------------------------------------------
// Colecciones
// ---------------------------------------------------------------------------

enum CollectionStatus {
  ACTIVE
  SUSPENDED
}

model Collection {
  id        String           @id @default(cuid())
  ownerId   String
  owner     User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  icon      String? // nombre de ícono o url de imagen
  status    CollectionStatus @default(ACTIVE)
  isDefault Boolean          @default(false) // Libros, Comics, Juguetes, ArtToys, Esculturas, Pinturas, Estatuas
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  members   CollectionMember[]
  itemLinks ItemCollection[]

  @@map("collections")
}

// ---------------------------------------------------------------------------
// Tags / Etiquetas
// ---------------------------------------------------------------------------

enum TagType {
  COLOR_PRINCIPAL
  FRANCHISE
  GENERIC
}

model Tag {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  type      TagType  @default(GENERIC)
  createdAt DateTime @default(now())

  itemLinks ItemTag[]

  @@unique([ownerId, name])
  @@map("tags")
}

// ---------------------------------------------------------------------------
// Objetos (Items)
// ---------------------------------------------------------------------------

enum ItemCategory {
  LIBRO
  COMIC
  ART_TOY
  ESTATUA
  FIGURA_ACCION
  JUGUETE
  ESCULTURA
  PINTURA
  OTRO
}

enum PackagingCondition {
  SUELTO
  BLISTER_SELLADO
  BLISTER_ABIERTO
  CON_CAJA_SIN_BLISTER
}

enum UsageState {
  NUEVO
  USADO
  ABIERTO
}

enum ConservationState {
  MINT
  NEAR_MINT
  BUEN_ESTADO
  CON_DETALLES
}

// Estado de vida del objeto dentro del inventario.
enum ItemStatus {
  ACTIVE
  PENDING_TRANSFER // "vendido" iniciado, esperando aceptación del receptor
  SOLD
  DONATED
  LOST
}

// Estado del cambio de ubicación actual (independiente de ItemStatus).
enum LocationAssignmentType {
  INDEFINIDO
  TEMPORAL
}

enum SyncStatus {
  SYNCED
  PENDING // offline-first: creado sin internet, badge "No sincronizado"
}

model Item {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name                 String
  category             ItemCategory
  packagingCondition   PackagingCondition
  usageState           UsageState
  conservationState    ConservationState?
  brand                String?
  toyLine              String?
  edition              String?
  scale                String?
  designer             String?
  releaseYear          Int?
  originalSetNumber    String?
  uniqueIdentifier     String? // SKU / UPC / ISBN
  purchasePrice        Decimal?           @db.Decimal(10, 2)
  currency             String             @default("MXN")
  purchaseLocationText String? // "lugar de compra" en texto libre
  acquisitionDate      DateTime?
  quantity             Int                @default(1)
  isGift               Boolean            @default(false)
  isFavorite           Boolean            @default(false)
  notes                String?            @db.Text

  // Solo aplica si category = COMIC (o LIBRO)
  comicCoverNumber String?
  comicIssueNumber String?
  comicWriter      String?
  comicPenciler    String?
  comicInker       String?
  comicColorist    String?
  comicPublisher   String?

  status ItemStatus @default(ACTIVE)

  currentLocationId   String?
  currentLocation     Location?              @relation("ItemCurrentLocation", fields: [currentLocationId], references: [id], onDelete: SetNull)
  permanentLocationId String?
  permanentLocation   Location?              @relation("ItemPermanentLocation", fields: [permanentLocationId], references: [id], onDelete: SetNull)
  locationAssignment  LocationAssignmentType @default(INDEFINIDO)
  currentSeasonId     String? // si locationAssignment = TEMPORAL
  currentSeason       Season?                @relation(fields: [currentSeasonId], references: [id], onDelete: SetNull)
  returnedFromSeason  Boolean                @default(true) // false mientras está "fuera" de su ubicación permanente por temporada

  syncStatus SyncStatus @default(SYNCED)

  // Último resultado de "precio de mercado" (plan FrikiTokens): se guarda para
  // poder ofrecer un re-consulta barata (MARKET_PRICE_CACHED) mostrando la
  // fecha del dato, en vez de cobrar siempre una llamada nueva a Gemini.
  lastMarketPriceResult Json?
  lastMarketPriceAt     DateTime?

  // Recorte 1:1 del objeto (bounding box de Gemini o, si no, cuadrado
  // centrado determinista) — usado para el re-ranking visual de "¿Ya lo
  // tengo?" y como miniatura de UI. Nullable: los objetos creados antes de
  // esta función no lo tienen y caen de vuelta a photos[0] al compararlos.
  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos            ItemPhoto[]
  collections       ItemCollection[]
  tags              ItemTag[]
  transfers         Transfer[]
  shareLink         ShareLink?
  marketPriceChecks MarketPriceCheck[]

  @@index([ownerId, status])
  @@map("items")
}

// Historial de cada consulta de "precio de mercado" (plan FrikiTokens §5.3.9.10):
// a diferencia de `Item.lastMarketPriceResult` (solo guarda la más reciente),
// esta tabla acumula todas las consultas para mostrarlas como historial en la
// ficha del objeto (fecha + estimación).
model MarketPriceCheck {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  result    Json
  fromCache Boolean
  ftCost    Int?
  createdAt DateTime @default(now())

  @@index([itemId, createdAt])
  @@map("market_price_checks")
}

model ItemPhoto {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("item_photos")
}

model ItemCollection {
  itemId       String
  item         Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([itemId, collectionId])
  @@map("item_collections")
}

model ItemTag {
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@map("item_tags")
}

// Enlace público (perfil simplificado, no requiere la app instalada).
model ShareLink {
  id        String   @id @default(cuid())
  itemId    String   @unique
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  token     String   @unique @default(cuid())
  createdAt DateTime @default(now())

  @@map("share_links")
}

// ---------------------------------------------------------------------------
// Transferencia ("vendido" estilo Pokémon)
// ---------------------------------------------------------------------------

enum TransferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model Transfer {
  id          String         @id @default(cuid())
  itemId      String
  item        Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromUserId  String
  fromUser    User           @relation("TransferSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User           @relation("TransferReceiver", fields: [toUserId], references: [id], onDelete: Cascade)
  status      TransferStatus @default(PENDING)
  expiresAt   DateTime // createdAt + 7 días (decisión confirmada en el plan)
  respondedAt DateTime?
  createdAt   DateTime       @default(now())

  @@map("transfers")
}

// ---------------------------------------------------------------------------
// Wishlist
// ---------------------------------------------------------------------------

model WishlistItem {
  id        String        @id @default(cuid())
  ownerId   String
  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  category  ItemCategory?
  photoUrl  String?
  foundAt   String? // dónde lo encontró
  price     Decimal?      @db.Decimal(10, 2)
  currency  String        @default("MXN")
  notes     String?       @db.Text
  createdAt DateTime      @default(now())

  @@map("wishlist_items")
}
