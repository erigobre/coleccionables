# MySQL/MariaDB — ajusta usuario/contraseña/host/puerto/nombre de BD
DATABASE_URL="mysql://usuario:password@localhost:3306/inventario_coleccionables"

# JWT
JWT_ACCESS_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_REFRESH_SECRET="cambia-esto-tambien-por-otro-secreto-distinto"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# IA visual (Gemini) — decisión confirmada en docs/00-PLAN-MAESTRO.md
GEMINI_API_KEY="tu-api-key-de-gemini"

# Storage de imágenes (baja resolución) — Cloudflare R2 / S3 compatible
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""

PORT=3000
